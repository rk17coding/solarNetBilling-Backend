<?xml version="1.0" encoding="UTF-8"?>
<!-- 1. Added strict validation attributes to prevent parser quirks -->
<Configuration status="WARN" monitorInterval="30">

  <Properties>
    <Property name="LOG_PATTERN">%d{dd-MM-yyyy~~HH:mm:ss} [%t] %-5level %logger{36} - %msg%n</Property>
    <Property name="LOG_FILE">logs/app.log</Property>
  </Properties>

  <Appenders>
    <!-- Console appender -->
    <Console name="ConsoleAppender" target="SYSTEM_OUT">
      <PatternLayout pattern="${LOG_PATTERN}"/>
    </Console>

    <!-- Rolling file appender (size + date based) -->
    <RollingFile name="FileAppender" fileName="${LOG_FILE}"
                 filePattern="logs/app-%d{dd-MM-yyyy}-%i.log.gz">
      <PatternLayout pattern="${LOG_PATTERN}"/>
      <Policies>
        <!-- 2. Modifying to ensure accurate daily rollover coordination -->
        <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
        <SizeBasedTriggeringPolicy size="10MB"/>
      </Policies>
      <DefaultRolloverStrategy max="30"/>
    </RollingFile>
  </Appenders>

  <Loggers>
    <!-- Package-level logger -->
    <Logger name="com.demo" level="DEBUG" additivity="false">
      <AppenderRef ref="ConsoleAppender"/>
      <AppenderRef ref="FileAppender"/>
    </Logger>

    <!-- Root logger (catch-all) -->
    <Root level="INFO">
      <AppenderRef ref="ConsoleAppender"/>
      <!-- 3. FIXED: Added the file appender here so framework logs are saved too -->
      <AppenderRef ref="FileAppender"/> 
    </Root>
  </Loggers>

</Configuration>
